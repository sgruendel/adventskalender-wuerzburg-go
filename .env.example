# Copy to .env (chmod 600) and fill in. Never commit .env.

# Public host name. Use minis12's own MyFRITZ! address, shown by the
# FRITZ!Box under Internet > Freigaben once a MyFRITZ!-Freigabe exists for minis12,
# e.g. minis12.<id>.myfritz.net. It also has minis12's IPv6
# address; the box's own name only has the box's.
SITE_ADDRESS=minis12.<id>.myfritz.net

# Database password; hex only, it is put into a URL. openssl rand -hex 24
POSTGRES_PASSWORD=

# Gmail: the full address (name@gmail.com, not just the name) and an app
# password (https://myaccount.google.com/apppasswords), 16 letters, no spaces
SMTP_USERNAME=
SMTP_PASSWORD=
# MAIL_FROM_NAME=Adventskalender-Gewinnbenachrichtigung
